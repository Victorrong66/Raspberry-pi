# Matrix hardware
MATRIX_COLS=64
MATRIX_ROWS=32
MATRIX_CHAIN_LENGTH=1
MATRIX_PARALLEL=1
MATRIX_BRIGHTNESS=60
# Use "adafruit-hat" for the RGB Matrix Bonnet/HAT, "regular" for direct GPIO wiring
MATRIX_HARDWARE_MAPPING=adafruit-hat
# Raises this if you see flicker on a Pi 4 (try 2-4). Leave at 1 for Pi 3B+/Zero 2 W.
MATRIX_GPIO_SLOWDOWN=1

# Location for weather. Either a city name ("Seattle,US") or "lat,lon"
LOCATION=Seattle,US
TIMEZONE=America/Los_Angeles
OPENWEATHER_API_KEY=

# Spotify (create an app at https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback
# Filled in automatically by scripts/spotify_auth.py
SPOTIFY_REFRESH_TOKEN=
